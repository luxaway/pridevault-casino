# Copy to deploy/devnet.env (never commit the real PEM).

CHAIN=D
PROXY=https://devnet-gateway.multiversx.com
API=https://devnet-api.multiversx.com
EXPLORER=https://devnet-explorer.multiversx.com

# Owner / deployer PEM. Prefer a different key than treasury.
PEM=./wallets/owner.pem

# After deploy, set SC= here so set-treasury.sh / skim work.
SC=

# PrideVault ops wallet (luxaway.elrond) — receives skim EGLD + ROAR.
TREASURY=erd1yqu7lartn9wgp65kauq98d0mpfnncaes3q3he4wwr8esp5e3ljkqd5a03k

# ROAR identifier on THIS chain. Mainnet = ROAR-e5185d.
# On devnet, deploy a test ESDT or use a faucet token and paste it here.
ROAR_TOKEN=ROAR-xxxxxx

# Amounts in smallest units.
# EGLD has 18 decimals. 0.05 EGLD = 50000000000000000
# ROAR has 10 decimals. 100 ROAR = 1000000000000
MIN_BET_EGLD=50000000000000000
CAP_MAX_EGLD=200000000000000000
MIN_BET_ROAR=1000000000000
CAP_MAX_ROAR=5000000000000

# ~20s per block on MultiversX. 30 blocks ≈ 10 min rounds.
ROUND_BLOCKS=30

MIN_BANKROLL_EGLD=5000000000000000000
MIN_BANKROLL_ROAR=10000000000000

# After deploy, fund once:
SEED_EGLD=10000000000000000000
SEED_ROAR=50000000000000
